{
  "devDependencies": {
    "chai-json-schema": "^2.0.1",
    "cypress": "^15.19.0",
    "cypress-plugin-api": "^2.12.0",
    "dotenv": "^17.4.2",
    "mochawesome": "^8.0.0",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  },
 "scripts": {
    "test": "cypress run",
    "clean:reports": "rimraf cypress/reports mochawesome-report",
    "report:merge": "mochawesome-merge cypress/reports/*.json > cypress/reports/output.json",
    "report:generate": "marge cypress/reports/output.json -o mochawesome-report"
  }
}
